# Umgebungsvariablen – Garden Time
# Kopiere diese Datei zu .env.local und fülle die Werte aus.
# WICHTIG: .env.local NIEMALS in Git committen!

# Admin-Passwort für den /admin Bereich
VITE_ADMIN_PASSWORD=dein-sicheres-passwort-hier

# API-Secret für Admin-Aktionen im Backend (gleicher Wert wie ADMIN_API_SECRET in Supabase)
VITE_ADMIN_API_SECRET=langer-zufaelliger-geheimer-string
